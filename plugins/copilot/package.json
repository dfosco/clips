{
  "name": "@dfosco/clips-copilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "description": "GitHub Copilot App canvas adapter for canonical Clips records and sessions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dfosco/clips.git",
    "directory": "plugins/copilot"
  },
  "homepage": "https://github.com/dfosco/clips/tree/main/plugins/copilot#readme",
  "keywords": ["clips", "copilot", "canvas"],
  "scripts": {
    "test": "node --test runtime/*.test.mjs canvas/*.test.mjs test/*.test.js",
    "build": "node scripts/build-canvas.mjs",
    "check:build": "node --input-type=module -e \"import { verifyCanvasBuild } from './src/canvas-build.js'; verifyCanvasBuild(process.cwd())\""
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.22",
    "@primer/octicons-react": "19.40.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4"
  }
}
