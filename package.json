{
  "name": "@dfosco/clips",
  "version": "1.6.0",
  "description": "Local-first planning and change-record workflow CLI",
  "type": "module",
  "bin": {
    "clips": "src/cli.js"
  },
  "scripts": {
    "test": "vitest run --config web/vitest.config.js",
    "test:all": "npm test && npm run test:package",
    "test:package": "npm run web:build && node scripts/package-smoke.js",
    "clips": "node src/cli.js",
    "web:dev": "vite --config web/vite.config.js",
    "web:build": "vite build --config web/vite.config.js",
    "web:test": "vitest run --config web/vitest.config.js",
    "prepublishOnly": "npm run test:all",
    "prepack": "npm run web:build",
    "preversion": "npm test",
    "publish:npm": "npm publish --access public",
    "update": "npm install -g @dfosco/clips && npm list -g @dfosco/clips --depth=0",
    "version": "node -e \"import('fs').then(fs => { const v = JSON.parse(fs.readFileSync('package.json','utf8')).version; fs.writeFileSync('src/version.js', 'export const version = \\'' + v + '\\';\\n'); })\" && git add src/version.js",
    "postversion": "git push && git push --tags && gh release create v$(node -p \"require('./package.json').version\") --generate-notes",
    "release": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dfosco/clips.git"
  },
  "author": "dfosco",
  "license": "MIT",
  "files": [
    "src/**/*.js",
    "!src/**/*.test.js",
    ".agents/skills/clips/SKILL.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "dist/web/"
  ],
  "keywords": [
    "cli",
    "issue-tracker",
    "github-issues",
    "jsonl",
    "git"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/dfosco/clips#readme",
  "bugs": {
    "url": "https://github.com/dfosco/clips/issues"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "bits-ui": "^2.18.1",
    "jsdom": "^30.0.1",
    "svelte": "^5.56.8",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "iconoir": "^7.12.1"
  },
  "dependencies": {}
}
