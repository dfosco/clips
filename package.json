{
  "name": "@dfosco/lanes",
  "version": "2.2.0",
  "description": "Local-first planning and change-record workflow CLI",
  "type": "module",
  "bin": {
    "lanes": "src/cli.js",
    "clips": "src/cli.js"
  },
  "scripts": {
    "test": "vitest run --config vitest.config.js",
    "test:all": "npm test && npm run test:package",
    "test:package": "node scripts/package-smoke.js",
    "lanes": "node src/cli.js",
    "clips": "node src/cli.js",
    "prepublishOnly": "npm run test:all",
    "preversion": "npm test",
    "publish:npm": "npm publish --access public",
    "update": "npm install -g @dfosco/lanes && npm list -g @dfosco/lanes --depth=0",
    "version": "node -e \"import('fs').then(fs => { const v = JSON.parse(fs.readFileSync('package.json','utf8')).version; fs.writeFileSync('src/version.js', 'export const version = \\'' + v + '\\';\\n'); })\" && git add src/version.js",
    "postversion": "git push && git push --tags && gh release create v$(node -p \"require('./package.json').version\") --generate-notes",
    "release": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dfosco/lanes.git"
  },
  "author": "dfosco",
  "license": "MIT",
  "files": [
    "src/**/*.js",
    "!src/**/*.test.js",
    ".agents/skills/lanes",
    ".agents/skills/lane-manager",
    ".agents/skills/lane-dev",
    ".agents/skills/lane-radar",
    ".agents/skills/lane-plugin",
    "skillshop.manifest.mjs",
    "npm-shrinkwrap.json",
    "README.md",
    "docs/",
    "CHANGELOG.md",
    "LICENSE",
    "scripts/install-copilot.js",
    "scripts/install-lane-manager.js",
    "scripts/install-live-skills.js",
    "plugins/copilot/",
    "!plugins/copilot/node_modules/**",
    "!plugins/copilot/**/*.test.js",
    "!plugins/copilot/**/*.test.mjs",
    "plugins/paseo/",
    "!plugins/paseo/node_modules/**",
    "!plugins/paseo/**/*.test.ts",
    "!plugins/paseo/**/*.test.tsx"
  ],
  "keywords": [
    "cli",
    "issue-tracker",
    "github-issues",
    "jsonl",
    "git"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/dfosco/lanes#readme",
  "bugs": {
    "url": "https://github.com/dfosco/lanes/issues"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "skillshop": "2.1.0"
  },
  "exports": {
    "./skillshop": "./skillshop.manifest.mjs",
    "./*": "./*"
  },
  "skillshop": {
    "schemaVersion": 1,
    "managedFiles": []
  }
}
